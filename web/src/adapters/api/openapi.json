{
  "components": {
    "schemas": {
      "Accessibility": {
        "description": "Низкий пол у машины. unknown никогда не показывается как yes.",
        "enum": [
          "yes",
          "no",
          "unknown"
        ],
        "title": "Accessibility",
        "type": "string"
      },
      "ApiError": {
        "additionalProperties": false,
        "description": "Единый формат ошибки: код, понятное сообщение по-русски, подробности.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "Arrival": {
        "additionalProperties": false,
        "properties": {
          "eta": {
            "$ref": "#/components/schemas/Eta"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          }
        },
        "required": [
          "vehicle",
          "eta"
        ],
        "title": "Arrival",
        "type": "object"
      },
      "ArrivalsResponse": {
        "additionalProperties": false,
        "properties": {
          "arrivals": {
            "items": {
              "$ref": "#/components/schemas/Arrival"
            },
            "title": "Arrivals",
            "type": "array"
          },
          "stop": {
            "$ref": "#/components/schemas/Stop"
          }
        },
        "required": [
          "stop",
          "arrivals"
        ],
        "title": "ArrivalsResponse",
        "type": "object"
      },
      "Bounds": {
        "additionalProperties": false,
        "description": "Прямоугольник на карте: юго-западный и северо-восточный углы.",
        "properties": {
          "northEast": {
            "$ref": "#/components/schemas/LatLon"
          },
          "southWest": {
            "$ref": "#/components/schemas/LatLon"
          }
        },
        "required": [
          "southWest",
          "northEast"
        ],
        "title": "Bounds",
        "type": "object"
      },
      "Direction": {
        "description": "Направление маршрута: A прямое, B обратное.",
        "enum": [
          "A",
          "B"
        ],
        "title": "Direction",
        "type": "string"
      },
      "Eta": {
        "additionalProperties": false,
        "description": "Когда машина придёт на остановку.",
        "properties": {
          "arriveAt": {
            "format": "date-time",
            "title": "Arriveat",
            "type": "string"
          },
          "diagnostics": {
            "$ref": "#/components/schemas/EtaDiagnostics"
          },
          "stopId": {
            "title": "Stopid",
            "type": "string"
          }
        },
        "required": [
          "stopId",
          "arriveAt",
          "diagnostics"
        ],
        "title": "Eta",
        "type": "object"
      },
      "EtaDiagnostics": {
        "additionalProperties": false,
        "description": "Служебные сведения о расчёте: для логов и тестов, не для экрана.",
        "properties": {
          "method": {
            "$ref": "#/components/schemas/EtaMethod"
          },
          "positionObservedAt": {
            "format": "date-time",
            "title": "Positionobservedat",
            "type": "string"
          }
        },
        "required": [
          "method",
          "positionObservedAt"
        ],
        "title": "EtaDiagnostics",
        "type": "object"
      },
      "EtaMethod": {
        "description": "Служебное: как посчитано время прихода. Интерфейс его не называет.",
        "enum": [
          "planned",
          "distance"
        ],
        "title": "EtaMethod",
        "type": "string"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Journey": {
        "additionalProperties": false,
        "description": "Один вариант маршрута от А до Б с разбивкой по шагам.",
        "properties": {
          "arriveAt": {
            "format": "date-time",
            "title": "Arriveat",
            "type": "string"
          },
          "departAt": {
            "format": "date-time",
            "title": "Departat",
            "type": "string"
          },
          "durationS": {
            "minimum": 0.0,
            "title": "Durations",
            "type": "integer"
          },
          "legs": {
            "items": {
              "discriminator": {
                "mapping": {
                  "transit": "#/components/schemas/TransitLeg",
                  "walk": "#/components/schemas/WalkLeg"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WalkLeg"
                },
                {
                  "$ref": "#/components/schemas/TransitLeg"
                }
              ]
            },
            "title": "Legs",
            "type": "array"
          },
          "lowFloorOnly": {
            "title": "Lowflooronly",
            "type": "boolean"
          },
          "transfers": {
            "minimum": 0.0,
            "title": "Transfers",
            "type": "integer"
          }
        },
        "required": [
          "legs",
          "departAt",
          "arriveAt",
          "durationS",
          "transfers",
          "lowFloorOnly"
        ],
        "title": "Journey",
        "type": "object"
      },
      "LatLon": {
        "additionalProperties": false,
        "description": "Точка на карте. Широта и долгота в градусах WGS 84.",
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "LatLon",
        "type": "object"
      },
      "Line": {
        "additionalProperties": false,
        "description": "Маршрут транспорта (например, автобус 13). Номера повторяются у разных видов.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TransportType"
          }
        },
        "required": [
          "id",
          "type",
          "number",
          "title"
        ],
        "title": "Line",
        "type": "object"
      },
      "LineDetails": {
        "additionalProperties": false,
        "properties": {
          "diagnostics": {
            "$ref": "#/components/schemas/SnapshotDiagnostics"
          },
          "directions": {
            "items": {
              "$ref": "#/components/schemas/LineDirection"
            },
            "title": "Directions",
            "type": "array"
          },
          "line": {
            "$ref": "#/components/schemas/Line"
          }
        },
        "required": [
          "line",
          "directions",
          "diagnostics"
        ],
        "title": "LineDetails",
        "type": "object"
      },
      "LineDirection": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "path": {
            "description": "Линия маршрута по порядку движения",
            "items": {
              "$ref": "#/components/schemas/LatLon"
            },
            "title": "Path",
            "type": "array"
          },
          "stops": {
            "description": "Остановки по порядку движения",
            "items": {
              "$ref": "#/components/schemas/Stop"
            },
            "title": "Stops",
            "type": "array"
          },
          "vehicles": {
            "items": {
              "$ref": "#/components/schemas/LineVehicle"
            },
            "title": "Vehicles",
            "type": "array"
          }
        },
        "required": [
          "direction",
          "stops",
          "path",
          "vehicles"
        ],
        "title": "LineDirection",
        "type": "object"
      },
      "LineSummary": {
        "additionalProperties": false,
        "properties": {
          "line": {
            "$ref": "#/components/schemas/Line"
          },
          "vehiclesOnLine": {
            "minimum": 0.0,
            "title": "Vehiclesonline",
            "type": "integer"
          }
        },
        "required": [
          "line",
          "vehiclesOnLine"
        ],
        "title": "LineSummary",
        "type": "object"
      },
      "LineVehicle": {
        "additionalProperties": false,
        "properties": {
          "nextStopOrder": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Номер следующей остановки в списке stops; null, если впереди остановок нет",
            "title": "Nextstoporder"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          }
        },
        "required": [
          "vehicle",
          "nextStopOrder"
        ],
        "title": "LineVehicle",
        "type": "object"
      },
      "LinesResponse": {
        "additionalProperties": false,
        "properties": {
          "diagnostics": {
            "$ref": "#/components/schemas/SnapshotDiagnostics"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/LineSummary"
            },
            "title": "Lines",
            "type": "array"
          }
        },
        "required": [
          "lines",
          "diagnostics"
        ],
        "title": "LinesResponse",
        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "appName": {
            "title": "Appname",
            "type": "string"
          },
          "cityBounds": {
            "$ref": "#/components/schemas/Bounds"
          },
          "lowFloorOnlyDefault": {
            "default": true,
            "title": "Lowflooronlydefault",
            "type": "boolean"
          },
          "refreshIntervalS": {
            "title": "Refreshintervals",
            "type": "integer"
          },
          "staleSeconds": {
            "description": "Служебное: порог свежести. Интерфейс не показывает.",
            "title": "Staleseconds",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "appName",
          "version",
          "cityBounds",
          "refreshIntervalS",
          "staleSeconds"
        ],
        "title": "Meta",
        "type": "object"
      },
      "Place": {
        "additionalProperties": false,
        "description": "Точка А или Б: адрес, место или точка, выбранная на карте.",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "point": {
            "$ref": "#/components/schemas/LatLon"
          }
        },
        "required": [
          "point"
        ],
        "title": "Place",
        "type": "object"
      },
      "PlaceKind": {
        "description": "Что за место нашёл поиск: от этого зависит значок в подсказке.",
        "enum": [
          "address",
          "street",
          "stop",
          "place",
          "area"
        ],
        "title": "PlaceKind",
        "type": "string"
      },
      "PlaceSuggestion": {
        "additionalProperties": false,
        "description": "Подсказка поиска адреса: что показать человеку и где это на карте.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PlaceKind"
          },
          "point": {
            "$ref": "#/components/schemas/LatLon"
          },
          "subtitle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtitle"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "point"
        ],
        "title": "PlaceSuggestion",
        "type": "object"
      },
      "ReverseResponse": {
        "additionalProperties": false,
        "properties": {
          "place": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlaceSuggestion"
              },
              {
                "type": "null"
              }
            ],
            "description": "Адрес или место у точки; null, если рядом ничего не нашлось"
          }
        },
        "required": [
          "place"
        ],
        "title": "ReverseResponse",
        "type": "object"
      },
      "RouteRequest": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/LatLon"
          },
          "lowFloorOnly": {
            "default": true,
            "title": "Lowflooronly",
            "type": "boolean"
          },
          "origin": {
            "$ref": "#/components/schemas/LatLon"
          }
        },
        "required": [
          "origin",
          "destination"
        ],
        "title": "RouteRequest",
        "type": "object"
      },
      "RouteResponse": {
        "additionalProperties": false,
        "properties": {
          "journeys": {
            "items": {
              "$ref": "#/components/schemas/Journey"
            },
            "maxItems": 3,
            "title": "Journeys",
            "type": "array"
          }
        },
        "required": [
          "journeys"
        ],
        "title": "RouteResponse",
        "type": "object"
      },
      "SearchResponse": {
        "additionalProperties": false,
        "properties": {
          "places": {
            "items": {
              "$ref": "#/components/schemas/PlaceSuggestion"
            },
            "title": "Places",
            "type": "array"
          }
        },
        "required": [
          "places"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SnapshotDiagnostics": {
        "additionalProperties": false,
        "description": "Служебное: когда получен снимок машин. Интерфейс не показывает.",
        "properties": {
          "complete": {
            "description": "Источник ответил по всем маршрутам в последний раз",
            "title": "Complete",
            "type": "boolean"
          },
          "fetchedAt": {
            "format": "date-time",
            "title": "Fetchedat",
            "type": "string"
          }
        },
        "required": [
          "fetchedAt",
          "complete"
        ],
        "title": "SnapshotDiagnostics",
        "type": "object"
      },
      "Stop": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "point": {
            "$ref": "#/components/schemas/LatLon"
          }
        },
        "required": [
          "id",
          "name",
          "point"
        ],
        "title": "Stop",
        "type": "object"
      },
      "TransitLeg": {
        "additionalProperties": false,
        "description": "Поездка на конкретной машине.",
        "properties": {
          "alightStop": {
            "$ref": "#/components/schemas/Stop"
          },
          "arriveAt": {
            "format": "date-time",
            "title": "Arriveat",
            "type": "string"
          },
          "boardStop": {
            "$ref": "#/components/schemas/Stop"
          },
          "departAt": {
            "format": "date-time",
            "title": "Departat",
            "type": "string"
          },
          "diagnostics": {
            "$ref": "#/components/schemas/EtaDiagnostics"
          },
          "kind": {
            "const": "transit",
            "default": "transit",
            "title": "Kind",
            "type": "string"
          },
          "line": {
            "$ref": "#/components/schemas/Line"
          },
          "lowFloor": {
            "$ref": "#/components/schemas/Accessibility"
          },
          "vehicleId": {
            "title": "Vehicleid",
            "type": "string"
          },
          "waitS": {
            "description": "Ожидание машины на остановке посадки",
            "minimum": 0.0,
            "title": "Waits",
            "type": "integer"
          }
        },
        "required": [
          "vehicleId",
          "line",
          "lowFloor",
          "boardStop",
          "alightStop",
          "waitS",
          "departAt",
          "arriveAt",
          "diagnostics"
        ],
        "title": "TransitLeg",
        "type": "object"
      },
      "TransportType": {
        "enum": [
          "bus",
          "trolleybus",
          "tram",
          "minibus"
        ],
        "title": "TransportType",
        "type": "string"
      },
      "Vehicle": {
        "additionalProperties": false,
        "description": "Машина на линии сейчас.",
        "properties": {
          "azimuth": {
            "anyOf": [
              {
                "maximum": 360.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Azimuth"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lineId": {
            "title": "Lineid",
            "type": "string"
          },
          "lowFloor": {
            "$ref": "#/components/schemas/Accessibility"
          },
          "number": {
            "title": "Number",
            "type": "string"
          },
          "point": {
            "$ref": "#/components/schemas/LatLon"
          },
          "positionObservedAt": {
            "description": "Служебное: когда машина отметилась (UTC). Интерфейс не показывает.",
            "format": "date-time",
            "title": "Positionobservedat",
            "type": "string"
          },
          "speedKmh": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speedkmh"
          },
          "type": {
            "$ref": "#/components/schemas/TransportType"
          }
        },
        "required": [
          "id",
          "lineId",
          "type",
          "number",
          "direction",
          "point",
          "lowFloor",
          "positionObservedAt"
        ],
        "title": "Vehicle",
        "type": "object"
      },
      "VehicleDetails": {
        "additionalProperties": false,
        "properties": {
          "nextStops": {
            "items": {
              "$ref": "#/components/schemas/Eta"
            },
            "title": "Nextstops",
            "type": "array"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          }
        },
        "required": [
          "vehicle",
          "nextStops"
        ],
        "title": "VehicleDetails",
        "type": "object"
      },
      "VehiclesResponse": {
        "additionalProperties": false,
        "properties": {
          "diagnostics": {
            "$ref": "#/components/schemas/SnapshotDiagnostics"
          },
          "vehicles": {
            "items": {
              "$ref": "#/components/schemas/Vehicle"
            },
            "title": "Vehicles",
            "type": "array"
          }
        },
        "required": [
          "vehicles",
          "diagnostics"
        ],
        "title": "VehiclesResponse",
        "type": "object"
      },
      "WalkLeg": {
        "additionalProperties": false,
        "description": "Пеший участок по профилю коляски.",
        "properties": {
          "destination": {
            "$ref": "#/components/schemas/Place"
          },
          "distanceM": {
            "minimum": 0.0,
            "title": "Distancem",
            "type": "integer"
          },
          "durationS": {
            "minimum": 0.0,
            "title": "Durations",
            "type": "integer"
          },
          "geometry": {
            "items": {
              "$ref": "#/components/schemas/LatLon"
            },
            "title": "Geometry",
            "type": "array"
          },
          "kind": {
            "const": "walk",
            "default": "walk",
            "title": "Kind",
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/Place"
          }
        },
        "required": [
          "origin",
          "destination",
          "distanceM",
          "durationS"
        ],
        "title": "WalkLeg",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Транспорт Новосибирска на линии сейчас и маршруты по низкопольным машинам.",
    "title": "GoPoint API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Неверные данные запроса"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Ошибка сервера"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Ещё не сделано"
          }
        },
        "summary": "Health",
        "tags": [
          "service"
        ]
      }
    },
    "/api/v1/live/routes": {
      "get": {
        "operationId": "live_routes_api_v1_live_routes_get",
        "parameters": [
          {
            "description": "true: только машины с низким полом (yes); false: все машины на линии с пометкой",
            "in": "query",
            "name": "lowFloorOnly",
            "required": false,
            "schema": {
              "default": true,
              "description": "true: только машины с низким полом (yes); false: все машины на линии с пометкой",
              "title": "Lowflooronly",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TransportType"
                },
                {
                  "type": "null"
                }
