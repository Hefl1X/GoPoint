# Скопируйте в .env и поменяйте при необходимости. Файл .env в git не попадает.

# Адрес сайта для Caddy. На Mac оставьте :80. На купленном сервере впишите домен
# (например gopoint.example.ru), и Caddy сам получит HTTPS-сертификат.
GOPOINT_SITE_ADDRESS=:80

# Порты на компьютере, через которые открывается сайт.
GOPOINT_HTTP_PORT=8080
GOPOINT_HTTPS_PORT=8443

# Откуда сайту можно обращаться к API (через запятую).
GOPOINT_CORS_ORIGINS=http://localhost:8080

# Положение машины старше этого числа секунд не используется (решение владельца).
GOPOINT_STALE_SECONDS=300
